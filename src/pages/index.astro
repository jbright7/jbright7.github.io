---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const recent = (await getCollection('notes'))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 5);
---
<BaseLayout title="Jonathan Bright" description="PhD student in physics at Caltech.">
  <main class="note-grid">
    <div></div>
    <article class="note">
      <h1>Jonathan Bright</h1>
      <p>
        I'm a PhD student at Caltech broadly interested in biophysics and out-of-equilibrium dynamics.
      </p>
      <p>
        <a href="/cv.pdf">CV</a>,
        <a href="mailto:jbright@caltech.edu">Contact me! (email)</a>,
        <a href="https://github.com/jbright7">GitHub</a>
      </p>
      <h2>Recently updated notes</h2>
      <ul>
        {recent.map((n) => (
          <li><a href={`/notes/${n.id}/`}>{n.data.title}</a></li>
        ))}
      </ul>
    </article>
  </main>
</BaseLayout>