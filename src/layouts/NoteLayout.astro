---
import BaseLayout from './BaseLayout.astro';

const { note, headings, backlinks = [] } = Astro.props;
const { title, description, updated, status, tags } = note.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const updatedText = updated.toLocaleDateString('en-US', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
---
<BaseLayout title={title} description={description}>
  <div class="note-grid">
    {toc.length > 0 && (
      <aside class="toc">
        <p class="toc-title">Contents</p>
        <ol>
          {toc.map((h) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )}
    <article class="note">
      <h1>{title}</h1>
      <p class="note-meta">
        <span class={`status status-${status}`}>{status}</span>
        Last updated <time datetime={updated.toISOString()}>{updatedText}</time>
      </p>
      <slot />
      {tags.length > 0 && (
        <p class="tags">Tags: {tags.join(', ')}</p>
      )}
      {backlinks.length > 0 && (
        <section class="backlinks">
          <h2>What links here</h2>
          <ul>
            {backlinks.map((b) => (
              <li><a href={`/notes/${b.id}/`}>{b.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </div>
</BaseLayout>